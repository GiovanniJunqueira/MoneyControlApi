PORT=8080
DATABASE_URL=jdbc:postgresql://localhost:5432/financeiro
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres
JWT_SECRET=troque-isso-por-um-segredo-bem-longo-e-aleatorio
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
FRONTEND_URL=http://localhost:5173
# Conta Gmail usada pra enviar o e-mail de "esqueci minha senha" (MAIL_PASSWORD é uma senha de app, não a senha normal da conta)
# Usada só como fallback - se RESEND_API_KEY estiver preenchida, o Resend é usado no lugar (ver abaixo)
MAIL_USERNAME=
MAIL_PASSWORD=
# Preferido em produção: hosts free tier (Render incluso) costumam bloquear porta SMTP de saída,
# então o Gmail acima não funciona neles. Resend manda por HTTPS - crie uma conta grátis em
# resend.com e cole a API key aqui. RESEND_FROM é opcional (usa "onboarding@resend.dev" se vazio).
RESEND_API_KEY=
RESEND_FROM=
